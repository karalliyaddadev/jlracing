{
  "name": "@bike-project/backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "echo 'No linter configured'",
    "type-check": "tsc -p tsconfig.json --noEmit",
